# ============================================================
# Evermodel Ops — 仓库根 .gitignore
# 子目录另有 backend/.gitignore、frontend/.gitignore，会一并生效。
# ============================================================

# ---- 依赖（体积巨大，绝不入库）----
frontend/node_modules/
backend/venv/
**/venv/
**/node_modules/

# ---- 构建产物 ----
# frontend/build 是 CRA 的站点根产物，nginx 直接挂载它
frontend/build/

# ---- 发布包（.tar.gz）----
# 前端：cd frontend && npm run dist          -> frontend/dist/
# 后端：cd backend  && python tools/build_release.py -> backend/dist/
frontend/dist/
backend/dist/

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 环境变量 / 凭据（含明文密码，绝不入库）----
.env
.env.local
*.env
!*.env.example

# ---- WorkBuddy 项目数据：工作记忆、改动备份、临时脚本 ----
.workbuddy/

# ---- 运行时产物（只忽略内容，保留目录本身）----
# ⚠️ 不能用 `backend/logs/` 这种写法：那样连 `.gitkeep` 一起忽略，而 git 无法反排除
#    一个已被忽略目录里的文件 → 目录不会入库 → supervisor 的 stdout_logfile 打不开，
#    5 个进程全部 spawn error。
backend/logs/*
!backend/logs/.gitkeep
backend/repos/*
backend/storage/transfer/*
!backend/storage/transfer/.gitkeep
backend/access.log
backend/db.sqlite3
*.sqlite3

# ---- 本地开发形态（deploy/local/，不入库）----
# 这是「本机 Windows + Docker Desktop」的私有开发形态：数据层端口、启动 bat、本机
# 覆盖配置等只对当前机器有意义，别人 clone 也不需要。故整目录不入库，只留在本地磁盘。
# （标准形态是 deploy/docker-compose.yaml + deploy/db + deploy/supervisor，那才是入库的。）
deploy/local/

# ---- 内部文档（不入库：架构说明、改动记录、上游参考图）----
docs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
