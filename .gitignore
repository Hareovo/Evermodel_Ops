# ============================================================
# Evermodel Ops — 仓库根 .gitignore
# 子目录另有 backend/.gitignore、frontend/.gitignore，会一并生效。
# ============================================================

# ---- 依赖（体积巨大，绝不入库）----
frontend/node_modules/
backend/venv/
**/venv/
**/node_modules/

# ---- 构建产物 ----
frontend/build/

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 环境变量 / 凭据（含明文密码，绝不入库）----
.env
.env.local
*.env
!*.env.example

# ---- WorkBuddy 项目数据：工作记忆、改动备份、临时脚本 ----
.workbuddy/

# ---- 运行时产物（只忽略内容，保留目录本身）----
# ⚠️ 不能用 `backend/logs/` 这种写法：那样连 `.gitkeep` 一起忽略，而 git 无法反排除
#    一个已被忽略目录里的文件 → 目录不会入库 → supervisor 的 stdout_logfile 打不开，
#    5 个进程全部 spawn error。
backend/logs/*
!backend/logs/.gitkeep
backend/repos/*
backend/storage/transfer/*
!backend/storage/transfer/.gitkeep
backend/access.log
backend/db.sqlite3
*.sqlite3

# ---- 本地/生产部署脚手架（不入库，按环境自行维护）----
deploy-local/
deploy-ubuntu/

# ---- 内部文档（不入库：部署与 Grafana 配置已在根 README 中）----
docs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
