# ============================================================
# Evermodel Ops — 仓库根 .gitignore
# 子目录另有 backend/.gitignore、frontend/.gitignore，会一并生效。
# ============================================================

# ---- 依赖（体积巨大，绝不入库）----
frontend/node_modules/
backend/venv/
**/venv/
**/node_modules/

# ---- 构建产物 ----
frontend/build/

# ---- Python ----
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 环境变量 / 凭据（含明文密码，绝不入库）----
.env
.env.local
*.env
!*.env.example

# ---- WorkBuddy 项目数据：工作记忆、改动备份、临时脚本 ----
.workbuddy/

# ---- 运行时产物 ----
backend/logs/
backend/repos/
backend/storage/deploy/
backend/storage/transfer/
!backend/storage/deploy/.gitkeep
!backend/storage/transfer/.gitkeep
backend/access.log
backend/db.sqlite3
*.sqlite3

# ---- 本地/生产部署脚手架（不入库，按环境自行维护）----
deploy-local/
deploy-ubuntu/

# ---- 内部文档（不入库：部署与 Grafana 配置已在根 README 中）----
docs/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store
