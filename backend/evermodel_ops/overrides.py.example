# Evermodel Ops 环境覆盖配置「示例」
#
# 用法：复制本文件为同目录下的 overrides.py
#   cp backend/evermodel_ops/overrides.py.example backend/evermodel_ops/overrides.py
# 然后按部署环境修改数据库地址、密码、Grafana 地址等。
#
# 说明：overrides.py 已被 .gitignore 忽略、不会入库（它含各环境的明文密码与地址）；
# 本示例文件会入库，因此只放占位符。
#
# 加载方式：由 evermodel_ops/settings.py 末尾的
#   `from evermodel_ops.overrides import *`
# 引入，优先级高于默认值。
import os

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

DEBUG = True
# 本地开发放开所有 Host（浏览器用 127.0.0.1 / localhost 都能进）。
# 若要让局域网其它机器访问，保持 '*' 即可；对外暴露时请收窄为具体域名。
ALLOWED_HOSTS = ['*']

MYSQL_HOST = os.environ.get('EVERMODEL_MYSQL_HOST', '127.0.0.1')
MYSQL_PORT = os.environ.get('EVERMODEL_MYSQL_PORT', '3306')
REDIS_HOST = os.environ.get('EVERMODEL_REDIS_HOST', '127.0.0.1')
REDIS_PORT = os.environ.get('EVERMODEL_REDIS_PORT', '6379')

DATABASES = {
    'default': {
        'ATOMIC_REQUESTS': True,
        'ENGINE': 'django.db.backends.mysql',
        'NAME': os.environ.get('EVERMODEL_MYSQL_DB', 'spug'),
        'USER': os.environ.get('EVERMODEL_MYSQL_USER', 'spug'),
        # ⚠️ 改成你自己的密码；或改用 EVERMODEL_MYSQL_PASSWORD 环境变量注入。
        'PASSWORD': os.environ.get('EVERMODEL_MYSQL_PASSWORD', 'change-me'),
        'HOST': MYSQL_HOST,
        'PORT': MYSQL_PORT,
        'OPTIONS': {
            'charset': 'utf8mb4',
            'sql_mode': 'STRICT_TRANS_TABLES',
        }
    }
}

# ---------------------------------------------------------------------------
# Redis 客户端的 socket 超时必须显式设为 None（重要，勿删）
#
# redis-py 8.0 起把 Connection 的默认值 DEFAULT_SOCKET_TIMEOUT 从 None 改成了 5s
# （redis/_defaults.py）。而本项目的 Redis 使用里有一批「永久阻塞」读操作：
#   - consumer/consumers.py  : channel layer 用 BZPOPMIN ... 5 收消息（brpop_timeout = 5）
#   - apps/exec/runworker.py : BLPOP timeout=0（一直等任务）
#   - apps/schedule/scheduler.py、apps/monitor/scheduler.py : BRPOP timeout=0
# 5s 的 socket 读超时和 BZPOPMIN 的 5s 阻塞时间撞在一起，抢跑失败就抛
# redis.exceptions.TimeoutError，daphne 随即以 1011 关闭 WebSocket ——
# 表现就是「Web 终端连上几秒后自动断开」，后台 worker 同样会被打死。
#
# 这里显式写回 None，恢复 redis-py < 8 的行为，且不依赖第三方库版本。
# ---------------------------------------------------------------------------
REDIS_POOL_KWARGS = {
    'socket_timeout': None,
    'socket_connect_timeout': 10,
}

CACHES = {
    'default': {
        'BACKEND': 'django_redis.cache.RedisCache',
        'LOCATION': f'redis://{REDIS_HOST}:{REDIS_PORT}/1',
        'KEY_PREFIX': 'spug',
        'OPTIONS': {
            'CLIENT_CLASS': 'django_redis.client.DefaultClient',
            # 注意：django_redis 自己的 SOCKET_TIMEOUT 选项只在值为真时才生效，
            # 传 None 会被忽略，因此必须走 CONNECTION_POOL_KWARGS。
            'CONNECTION_POOL_KWARGS': dict(REDIS_POOL_KWARGS),
        }
    }
}

CHANNEL_LAYERS = {
    'default': {
        'BACKEND': 'channels_redis.core.RedisChannelLayer',
        'CONFIG': {
            # 用 dict 形式的 host 才能把 socket_timeout 透传给 redis 连接池。
            'hosts': [dict(host=REDIS_HOST, port=int(REDIS_PORT), **REDIS_POOL_KWARGS)],
            'prefix': 'spug:channel',
            'capacity': 1000,
            'expiry': 120,
        },
    },
}

# 默认值是 BASE_DIR.parent.parent/'repos'（为容器里的 /data/repos 设计），
# 本地开发改回 backend/repos，保持仓库、构建产物都在项目内。
REPOS_DIR = os.path.join(BASE_DIR, 'repos')
BUILD_DIR = os.path.join(REPOS_DIR, 'build')

# ---------------------------------------------------------------------------
# Grafana 监控大屏
#
# ⚠️ 地址/超时/看板白名单**正常应该在界面上配**：「系统管理 / 系统设置 / 监控大屏」，
#    存在 settings 表的 grafana 键里，改完立即生效、不用重启后端。
#    下面这三个常量只是**没在界面上配过时**的初始值 / 兜底值，
#    适合用环境变量做首次部署（界面上一保存，就以界面里的为准）。
#
# 后端会向地址的 /api/search 拉看板清单，前端再用 iframe 把看板嵌进 /grafana 页面。
# 前提是 Grafana 侧放行两件事（见项目 README 的「监控大屏（内嵌 Grafana）」一节）：
#   1. [security] allow_embedding = true      —— 否则 Grafana 会发 X-Frame-Options: deny，iframe 直接空白
#   2. [auth.anonymous] enabled = true, org_role = Viewer
#      —— 否则 iframe 里会弹 Grafana 自己的登录页（后端探测到 401 会把这个结论回给页面）
#
# GRAFANA_DASHBOARDS 留空表示自动显示全部看板；要固定顺序/只留几个时再放开：
#   GRAFANA_DASHBOARDS = [
#       {'uid': 'a1b2c3', 'title': '集群 A'},
#       {'uid': 'd4e5f6', 'title': '集群 B'},
#   ]
# ---------------------------------------------------------------------------
GRAFANA_URL = os.environ.get('EVERMODEL_GRAFANA_URL', 'http://127.0.0.1:3000')
GRAFANA_DASHBOARDS = ()
GRAFANA_TIMEOUT = 5
