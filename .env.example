# ============================================================================
# Evermodel Ops — 环境变量示例（供根目录 docker-compose.yaml 使用）
#
# 用法：
#   cp .env.example .env       # Linux / macOS / Git Bash
#   copy .env.example .env     # Windows CMD
# 然后按环境修改。.env 已被仓库根 .gitignore 忽略、不会入库。
#
# 本文件会入库，所以只放「初始默认值」，不放真实生产密码。
# ============================================================================

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# ⚠️ 生产环境务必改成强密码，并同步修改 backend/evermodel_ops/overrides.py
#    （或给后端进程注入同名 EVERMODEL_MYSQL_PASSWORD 环境变量）。
#
# ⚠️ 这个变量只对**首次初始化数据卷**生效。容器已经跑起来过之后再改它，
#    数据库里的密码不会跟着变 —— 换密码要走 ALTER USER 或重建数据卷，
#    详见 db/README.md 第五节。
EVERMODEL_MYSQL_ROOT_PASSWORD=evermodel_ops

# 宿主机映射端口。宿主机 3306 已被占用时改成别的（如 13306），
# 同时要把 backend/evermodel_ops/overrides.py 的 EVERMODEL_MYSQL_PORT 改成同一个值。
EVERMODEL_MYSQL_PORT_MAP=3306

# ---------------------------------------------------------------------------
# Redis（业务队列 + WebSocket channel layer）
# ---------------------------------------------------------------------------
EVERMODEL_REDIS_PORT_MAP=6379

# ---------------------------------------------------------------------------
# nginx（前端静态文件 + /api 反向代理）
# ---------------------------------------------------------------------------
EVERMODEL_NGINX_PORT_MAP=80

# ---------------------------------------------------------------------------
# 后端进程的环境变量不在这里配
# ---------------------------------------------------------------------------
# 后端 5 个进程由 supervisor 在宿主机上拉起（deploy/supervisor/），它们的配置来源：
#   1) backend/evermodel_ops/overrides.py        —— 常规做法，改完重启进程生效
#   2) deploy/supervisor/evermodel_ops.conf 里各 [program:*] 的 environment= 行
# 常用项：EVERMODEL_SECRET_KEY、EVERMODEL_MYSQL_PASSWORD、
#        EVERMODEL_REDIS_HOST / _PORT、EVERMODEL_GRAFANA_URL
