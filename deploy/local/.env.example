# Evermodel Ops 本地开发环境变量「示例」
#
# 用法：复制本文件为 .env 并填入你自己的密码
#   cd deploy/local
#   cp .env.example .env        # Linux / macOS / Git Bash
#   copy .env.example .env      # Windows CMD
#
# 说明：.env 已被 .gitignore 忽略、不会入库；本示例文件会入库，所以只放占位符。
# docker-compose.yml 通过 ${EVERMODEL_MYSQL_*} 引用这两个变量。

EVERMODEL_MYSQL_PASSWORD=change-me
EVERMODEL_MYSQL_ROOT_PASSWORD=change-me
