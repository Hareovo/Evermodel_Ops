# ============================================================================
# 换行符策略
#
# 背景：开发机是 Windows（core.autocrlf=true），运行环境是 Linux。
# 文本文件若带 CRLF 落到 Linux，shell 脚本会直接失败：
#     bash: ./install.sh: /bin/bash^M: bad interpreter: No such file or directory
#     或者  \r': command not found
# 而 supervisor / systemd / nginx 的配置文件被 CRLF 污染时，也常报
# 「unexpected end of file」「unknown directive」这类看不出根因的错。
#
# 所以这里显式规定：**仓库里一律 LF**（除 Windows 批处理外），各平台检出结果一致。
# ============================================================================

* text=auto

# --- 会在 Linux 上被直接执行、或被程序逐行读取的文件：一律 LF ---
*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.service   text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.example   text eol=lf
*.css       text eol=lf
*.less      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.cfg       text eol=lf
*.toml      text eol=lf
Dockerfile  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# --- Windows 批处理必须是 CRLF，否则 cmd.exe 解析会出问题 ---
#     （当前仓库没有 .bat/.cmd，留着防止以后加进来踩坑）
*.bat       text eol=crlf
*.cmd       text eol=crlf

# --- 二进制：禁止任何换行转换 ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.gz    binary
*.tgz   binary
*.zip   binary
*.tar   binary
*.whl   binary
*.exe   binary
*.so    binary
*.dll   binary
